# MongoDB Atlas or Local MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fb_exporter?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=https://exporter.yurafy.com
NEXTAUTH_SECRET=your-random-nextauth-secret-here-at-least-32-chars

# Default Administrator Account
ADMIN_INITIAL_EMAIL=admin@fbexporter.com
ADMIN_INITIAL_PASSWORD=admin123456
